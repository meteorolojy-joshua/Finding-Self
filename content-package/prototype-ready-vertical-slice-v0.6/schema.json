      "id": "SRT-02",
      "rule": "A change of page role or cognitive lens must be requested by the answer or introduced by a bridge."
    },
    {
      "id": "SRT-03",
      "rule": "A transition with ambiguous continuity must visibly acknowledge what the user selected."
    },
    {
      "id": "SRT-04",
      "rule": "Relevant prior state must be carried forward and displayed where needed."
    },
    {
      "id": "SRT-05",
      "rule": "Fulfill or operationalize an answer’s promise before asking what to retain or closing."
    },
    {
      "id": "SRT-06",
      "rule": "Retention is a separate, optional choice; it is not a substitute for fulfilling an answer."
    },
    {
      "id": "SRT-07",
      "rule": "Expansion preserves context and does not silently restart."
    },
    {
      "id": "SRT-08",
      "rule": "A restart is an explicit choice distinct from expanding the current thread."
    },
    {
      "id": "SRT-09",
      "rule": "Low-capacity paths can complete independently without escalation to a longer path."
    },
    {
      "id": "SRT-10",
      "rule": "Actions are gated by actual availability, safety, capacity, and jurisdiction."
    },
    {
      "id": "SRT-11",
      "rule": "Every displayed answer must fit its question grammatically and conceptually."
    },
    {
      "id": "SRT-12",
      "rule": "Uncertainty, privacy, no action, delay, and protective responses are valid endpoints."
    },
    {
      "id": "SRT-13",
      "rule": "Recovery preserves agency and offers back, reword, alternate route, skip, and exit where applicable."
    },
    {
      "id": "SRT-14",
      "rule": "The system does not use guilt, pressure, or forced disclosure."
    },
    {
      "id": "SRT-15",
      "rule": "Power analysis includes interpersonal, structural, material, and technological influences without imposing an interpretation."
    },
    {
      "id": "SRT-16",
      "rule": "The app may scaffold reflection but never performs external action in the user’s place."
    },
    {
      "id": "SRT-17",
      "rule": "Free text is optional, restrained, and never required to unlock completion."
    },
    {
      "id": "SRT-18",
      "rule": "Every destination, conditional branch, state requirement, return pointer, and fallback is explicit."
    }
  ],
